# Copy to .env:  cp .env.example .env

# --- Neo4j Desktop (local) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# --- Qdrant (local) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=graphrag_chunks

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EXTRACTION_MODEL=qwen2.5:3b-instruct
# Local model used for answer synthesis when REASONING_PROVIDER=ollama (or as fallback).
# REASONING_MODEL=qwen2.5:3b-instruct

# --- Reasoning provider ---
# Options: "groq" (ultra-fast cloud Llama-3.3), "google" (Gemini), "ollama" (local default / fallback).
# All other steps (embedding, extraction, classification, Cypher gen) run on Ollama.
# REASONING_PROVIDER=groq

# --- Groq (Get key from: https://console.groq.com/keys) ---
# GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Google AI Studio (Get key from: https://aistudio.google.com/app/apikey) ---
# GOOGLE_API_KEY=AIza_YOUR_KEY_HERE
# GOOGLE_MODEL=gemini-3.8-flash

# Optional tuning (apply to whichever provider is active)
# REASONING_TEMPERATURE=0
# REASONING_TIMEOUT_S=20
