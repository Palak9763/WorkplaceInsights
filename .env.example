# Copy to .env:  cp .env.example .env

# --- Neo4j Desktop (local) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password-here

# --- Qdrant (local) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=graphrag_chunks

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EXTRACTION_MODEL=qwen2.5:3b-instruct
# Local model used for answer synthesis when REASONING_PROVIDER=ollama (or as fallback).
# REASONING_MODEL=qwen2.5:3b-instruct

# --- Reasoning provider ---
# Two options: "ollama" (default, local) or "google" (Google AI Studio / Gemini).
# All other steps (embedding, extraction, classification, Cypher gen) always run on Ollama.
# REASONING_PROVIDER=ollama

# Google AI Studio credentials — only needed when REASONING_PROVIDER=google.
# Get your key from: https://aistudio.google.com/app/apikey
# NEVER commit a real key here; add it only to your local .env (which is git-ignored).
# GOOGLE_API_KEY=AIza_YOUR_KEY_HERE
# GOOGLE_MODEL=gemini-2.0-flash

# Optional tuning (apply to whichever provider is active)
# REASONING_TEMPERATURE=0
# REASONING_TIMEOUT_S=20
